# ──────────────────────────────────────────────────────────
# MongoDB Atlas Connection String
# ──────────────────────────────────────────────────────────
# Replace with your actual Mongo Atlas connection URL:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# ──────────────────────────────────────────────────────────
# Admin CMS Credentials (for /admin login)
# ──────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# ──────────────────────────────────────────────────────────
# GitHub Personal Access Token (for /api/github-activity)
# ──────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
